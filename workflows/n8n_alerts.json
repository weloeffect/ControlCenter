{
  "name": "Check and Visit Operations Center - Daily operational alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {"interval": [{"field": "cronExpression", "expression": "0 7 * * *"}]}
      },
      "id": "daily-trigger",
      "name": "Every day at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/alerts/run",
        "options": {}
      },
      "id": "run-alert-api",
      "name": "Evaluate alert rules",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "id": "has-alerts",
              "leftValue": "={{ $json.active_alerts }}",
              "rightValue": 0,
              "operator": {"type": "number", "operation": "gt"}
            }
          ],
          "combinator": "and"
        }
      },
      "id": "alert-check",
      "name": "Any active alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "summary", "name": "summary", "value": "={{ $json.active_alerts + ' active operational alerts' }}", "type": "string"},
            {"id": "details", "name": "details", "value": "={{ $json.top_messages }}", "type": "array"}
          ]
        }
      },
      "id": "notification-payload",
      "name": "Prepare notification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [980, 220]
    }
  ],
  "connections": {
    "Every day at 07:00": {"main": [[{"node": "Evaluate alert rules", "type": "main", "index": 0}]]},
    "Evaluate alert rules": {"main": [[{"node": "Any active alerts?", "type": "main", "index": 0}]]},
    "Any active alerts?": {"main": [[{"node": "Prepare notification", "type": "main", "index": 0}], []]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "90cc79a2-fd6f-4d98-a73b-705fce164ffe",
  "meta": {"templateCredsSetupCompleted": false},
  "tags": []
}
